				},
				{
					"name": "Thúy Diệu",
					"cta": "Xem câu chuyện",
					"url": "",
					"imageId": 0,
					"imageUrl": "",
					"position": "51% 40%"
				},
				{
					"name": "Hngle",
					"cta": "Xem câu chuyện",
					"url": "",
					"imageId": 0,
					"imageUrl": "",
					"position": "50% 50%"
				},
				{
					"name": "Aric",
					"cta": "Khám phá nhà sáng tạo",
					"url": "",
					"imageId": 0,
					"imageUrl": "",
					"position": "50% 50%"
				}
			]
		},
		"linkStyle": {
			"type": "string",
			"default": "link"
		},
		"linkIcon": {
			"type": "string",
			"default": "none"
		}
	},
	"textdomain": "ai-zippy-child",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
