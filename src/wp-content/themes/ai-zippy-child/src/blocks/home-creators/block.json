		},
		"titleAccent": {
			"type": "string",
			"default": "Welive."
		},
		"linkText": {
			"type": "string",
			"default": "Xem tất cả"
		},
		"linkUrl": {
			"type": "string",
			"default": "/artists/"
		},
		"creators": {
			"type": "array",
			"default": [
				{
					"name": "Lê Hòa",
					"cta": "Xem câu chuyện",
					"url": "",
					"imageId": 0,
					"imageUrl": "",
