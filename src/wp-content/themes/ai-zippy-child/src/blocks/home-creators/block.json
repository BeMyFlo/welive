{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy-child/home-creators",
	"version": "1.0.0",
	"title": "[Home] Creators grid",
	"category": "welive",
	"icon": "id-alt",
	"description": "Heading plus a grid of creator photo cards with links.",
	"supports": {
		"html": false,
		"align": [
			"full"
		]
